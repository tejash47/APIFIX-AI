# =========================================================================
# APIFIX AI — Backend Environment Template (backend/.env.example)
# Placeholders only. NEVER commit real secrets to Git.
# =========================================================================

# --- Server Core & Environment ---
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://app.apifix.ai
FRONTEND_URL=https://app.apifix.ai
ALLOWED_ORIGINS=https://app.apifix.ai
APIFIX_DEMO_MODE=false

# --- Authentication & JWT Security (Required in Production) ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
INBOUND_WEBHOOK_SIGNING_SECRET=your_webhook_hmac_signing_secret_here

# --- Supabase PostgreSQL Database (Optional - falls back to memory store) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DB_QUERY_TIMEOUT_MS=5000

# --- AI Provider API Credentials ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_MS=30000
APPROVAL_TIMEOUT_MS=300000

# --- GitHub Automation (Optional for PR creation) ---
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Stripe Billing & Subscriptions ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_PRICE_PRO=price_pro_monthly_49
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_199

# --- Monitoring & Observability Integrations (Optional) ---
SENTRY_DSN=
DATADOG_API_KEY=
PAGERDUTY_INTEGRATION_KEY=
SLACK_WEBHOOK_URL=
