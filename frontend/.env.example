# =========================================================================
# APIFIX AI — Frontend Client Environment Template (frontend/.env.example)
# Public variables only. NEVER put private server secrets here.
# =========================================================================

# Public Backend API Gateway URL (Consumed by browser fetch clients)
NEXT_PUBLIC_BACKEND_URL=https://api.apifix.ai

# Public Web Application Base URL
NEXT_PUBLIC_APP_URL=https://app.apifix.ai

# Client Telemetry Disabled by Default
NEXT_TELEMETRY_DISABLED=1
