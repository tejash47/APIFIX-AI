# =========================================================================
# APIFIX AI — Global Root Environment Template (.env.example)
# Placeholders only. NEVER commit real secret values to version control.
# =========================================================================

# --- Server Core & Networking ---
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://app.apifix.ai
FRONTEND_URL=https://app.apifix.ai
ALLOWED_ORIGINS=https://app.apifix.ai

# --- Security & JWT Authentication ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
INBOUND_WEBHOOK_SIGNING_SECRET=your_webhook_hmac_signing_secret_here

# --- Supabase Cloud Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI Providers (At least one provider required in production) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- GitHub Automation ---
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Stripe Billing & Subscriptions ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# --- Public Frontend Client Variables ---
NEXT_PUBLIC_BACKEND_URL=https://api.apifix.ai
NEXT_PUBLIC_APP_URL=https://app.apifix.ai
